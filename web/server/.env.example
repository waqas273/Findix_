# Server Configuration
PORT=5001
NODE_ENV=development

# MongoDB Connection
MONGO_URI=mongodb://127.0.0.1:27017/findix_db

# JWT Authentication
JWT_SECRET=findix_super_secret_jwt_key_2026_lost_but_never_gone
JWT_EXPIRE=30d

# Cloudinary Storage (For QR codes & Item photos)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Client App URL (For CORS & QR redirect targets)
CLIENT_URL=http://localhost:5173
